# Forex/commodity price feed. Leave unset to use mocked sample data.
TWELVEDATA_API_KEY=

# Economic calendar provider -- no provider integrated yet regardless of
# this being set (see app/data_sources/econ_calendar.py); reserved seam.
ECON_CALENDAR_API_KEY=

# Crypto market data (market cap/volume/FDV/BTC dominance). Optional -- the
# basic CoinGecko endpoints this uses are keyless; setting this only raises
# the rate limit.
COINGECKO_API_KEY=

# US central bank rate/CPI/NFP/10Y yield (app/data_sources/macro_data.py).
# Unlike COINGECKO_API_KEY above, this one is required even for basic reads
# -- get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# General financial news
NEWS_API_KEY=

# Cache TTL in seconds for analysis results
ANALYSIS_CACHE_TTL_SECONDS=180

# Note: crypto safety-gate (GoPlus + DexScreener) and crypto derivatives
# (Binance public futures API) have no corresponding key here -- both are
# fully keyless public endpoints, called directly by
# app/data_sources/crypto_safety.py and app/data_sources/derivatives.py.
