# Forex/commodity price feed. Leave unset to use mocked sample data.
TWELVEDATA_API_KEY=

# Economic calendar provider -- no provider integrated yet regardless of
# this being set (see app/data_sources/econ_calendar.py); reserved seam.
ECON_CALENDAR_API_KEY=

# Crypto market data (market cap/volume/FDV/BTC dominance). Optional -- the
# basic CoinGecko endpoints this uses are keyless; setting this only raises
# the rate limit.
COINGECKO_API_KEY=

# US central bank rate/CPI/NFP/10Y yield (app/data_sources/macro_data.py).
# Unlike COINGECKO_API_KEY above, this one is required even for basic reads
# -- get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# General financial news
NEWS_API_KEY=

# LP-holder-type heuristic (app/data_sources/lp_lock_heuristic.py) -- is the
# top LP-token holder a contract or a plain wallet. Free but requires signup
# at https://bscscan.com/apis. Deliberately NOT true lock verification (see
# that file's docstring); unset means "not checked", never "assumed safe".
BSCSCAN_API_KEY=

# Specialist LLM synthesis agent (app/agents/specialist_agent.py) -- makes
# the final BUY/SELL/HOLD call itself from the already-computed evidence,
# instead of the deterministic weighted-formula fallback. Pass ?model=claude
# or ?model=gemini on /api/v1/analysis/{symbol} to use it; omit either key
# and that provider just isn't available (falls back to the formula, never
# a fabricated verdict). Two independent keys so a free/demo tier can run on
# Gemini while a paid tier uses Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Persistent support/resistance zone memory (app/data_sources/sr_memory_store.py)
# -- a local SQLite file path, not a separate database server. Change this if
# you want it somewhere other than the working directory (e.g. a persistent
# volume on the VPS so history survives redeploys).
SR_MEMORY_DB_PATH=sr_memory.db

# Cache TTL in seconds for analysis results
ANALYSIS_CACHE_TTL_SECONDS=180

# Note: crypto safety-gate (GoPlus + DexScreener), crypto derivatives incl.
# spot CVD (Binance), token unlocks (DefiLlama), and non-US macro (World
# Bank + ECB) have no corresponding key here -- all are fully keyless public
# endpoints, called directly by app/data_sources/crypto_safety.py,
# derivatives.py, token_unlocks.py, and intl_macro.py.
